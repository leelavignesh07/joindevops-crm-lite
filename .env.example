# Copy to .env (local dev) or .env (on the EC2 instance, referenced by
# docker-compose.prod.yml's env_file). Never commit the real .env file.

# ---------- Database (AWS RDS PostgreSQL in production) ----------
DATABASE_URL="postgresql://crm:crm_dev_password@localhost:5432/crm?schema=public"

# ---------- Redis (BullMQ queues) ----------
REDIS_URL="redis://localhost:6379"

# ---------- NextAuth ----------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# Public URL of the deployed app (used for OAuth callback + webhook URL display)
NEXTAUTH_URL="http://localhost:3000"

# ---------- Google Workspace SSO ----------
# Create OAuth 2.0 credentials in Google Cloud Console (see DEPLOYMENT.md)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
# Employees must sign in with an email on this Google Workspace domain
ALLOWED_GOOGLE_WORKSPACE_DOMAIN="joindevops.com"

# ---------- AWS SES (acknowledgement emails) ----------
AWS_REGION="ap-south-1"
# Credentials are normally supplied via the EC2 instance IAM role instead of
# static keys — only set these for local development:
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
SES_FROM_EMAIL="admissions@joindevops.com"

# ---------- WATI (direct WhatsApp integration) ----------
# From WATI dashboard > API Docs. Endpoint looks like https://live-mt-server.wati.io/12345
WATI_API_ENDPOINT="https://live-mt-server.wati.io/REPLACE_WITH_TENANT_ID"
WATI_API_KEY="replace-with-wati-api-key"
# Name of the pre-approved WhatsApp template used for the first outbound message
WATI_ACK_TEMPLATE_NAME="lead_acknowledgement"

# ---------- Misc ----------
BRAND_NAME="JoinDevOps"
